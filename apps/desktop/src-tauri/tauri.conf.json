{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MqttRustUI",
  "version": "0.1.0",
  "identifier": "com.mqttrustui.app",
  "build": {
    "frontendDist": "../../ui/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev --prefix ../../ui",
    "beforeBuildCommand": "npm run build --prefix ../../ui"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MqttRustUI",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 680
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  },
  "plugins": {}
}
